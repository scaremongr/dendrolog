{
    "name": "nginx / Apache access (combined)",
    "description": "HTTP access log, combined format: client - user [time] \"request\" status bytes \"referer\" \"user agent\". The common format (without referer and user agent) is read too.",
    "version": 3,
    "type": "dynamic-block-schema",
    "linePrefix": "",
    "blocks": [
        {
            "name": "Client",
            "kind": "regex",
            "leadingText": "",
            "closingText": "",
            "separator": "",
            "customRegex": "(?:\\d{1,3}\\.){3}\\d{1,3}|[0-9A-Fa-f]*:[0-9A-Fa-f:.]*"
        },
        {
            "name": "Ident",
            "kind": "regex",
            "leadingText": "",
            "closingText": "",
            "separator": "",
            "customRegex": "\\S+",
            "ignored": true
        },
        {
            "name": "User",
            "kind": "regex",
            "leadingText": "",
            "closingText": "",
            "separator": "",
            "customRegex": "\\S+"
        },
        {
            "name": "Time",
            "kind": "timestamp",
            "leadingText": "[",
            "closingText": "]",
            "separator": "",
            "customRegex": ""
        },
        {
            "name": "Request",
            "kind": "regex",
            "leadingText": "\"",
            "closingText": "\"",
            "separator": "",
            "customRegex": "(?:[^\"\\\\]|\\\\.)*"
        },
        {
            "name": "Status",
            "kind": "integer",
            "leadingText": "",
            "closingText": "",
            "separator": "",
            "customRegex": ""
        },
        {
            "name": "Bytes",
            "kind": "regex",
            "leadingText": "",
            "closingText": "",
            "separator": "",
            "customRegex": "\\d+|-"
        },
        {
            "name": "Referer",
            "kind": "regex",
            "leadingText": "\"",
            "closingText": "\"",
            "separator": "",
            "customRegex": "(?:[^\"\\\\]|\\\\.)*"
        },
        {
            "name": "User agent",
            "kind": "regex",
            "leadingText": "\"",
            "closingText": "\"",
            "separator": "",
            "customRegex": "(?:[^\"\\\\]|\\\\.)*"
        }
    ]
}
